{
  "name": "onenord-vscode",
  "displayName": "OneNord",
  "description": "OneNord is a clean and vibrant theme that combines the Nord and Atom One Dark color palettes.",
  "publisher": "s1e2b3i4",
  "homepage": "https://github.com/s1e2b3i4/onenord-vscode",
  "bugs": {
    "url": "https://github.com/s1e2b3i4/onenord-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s1e2b3i4/onenord-vscode"
  },
  "license": "GPL-3.0-or-later",
  "version": "0.6.2",
  "engines": {
    "vscode": "^1.90.0"
  },
  "galleryBanner": {
    "color": "#2E3440",
    "theme": "dark"
  },
  "icon": "assets/pluginIcon.png",
  "markdown": "github",
  "keywords": [
    "arctic",
    "north",
    "bluish",
    "clean",
    "elegant",
    "onenord",
    "onedark"
  ],
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "OneNord",
        "uiTheme": "vs-dark",
        "path": "./theme/one-nord.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "onenord.inline-url.injection",
        "path": "./grammars/inline-url.injection.json",
        "injectTo": [
          "source.python",
          "source.js",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "source.go",
          "source.rust",
          "source.java",
          "source.c",
          "source.cpp",
          "source.cs",
          "source.php",
          "source.ruby",
          "source.shell",
          "source.json",
          "source.jsonc",
          "source.yaml",
          "source.toml"
        ]
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "js-yaml": "^5.2.3"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "package": "vsce package -o ./bin/one-nord.vsix",
    "vscode:prepublish": "npm run build",
    "vsce-publish": "vsce publish"
  }
}
